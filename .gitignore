node_modules/

# Рантайм-артефакты петли: лог, состояние, лок, сохранённые выводы сессий. Пишутся рядом
# с ядром боевым прогоном — и прогоном тестов, если предохранитель побочек выключен
# (ровно так они однажды и завелись здесь). В репозитории им не место.
ralph.log
ralph.state.json
ralph.lock
ralph.requests.jsonl
sessions/
monitor.out

# Проектная половина промпт-контракта и конфиг принадлежат ПОТРЕБИТЕЛЮ: канон везёт
# только шаблон `ralph.project.md.example`. Оказавшись здесь, они стали бы следом проекта.
ralph.project.md
ralph.config.json
# Исключение одно: канон — сам себе потребитель, когда петля работает над ним. Его
# проектная половина описывает этот репозиторий, а не чужой, и обязана лежать в git:
# сессии идут в дереве-соседе, куда игнорируемый файл не попадает. Конфиг остаётся
# локальным — раннер читает его из дерева человека, и в нём абсолютные пути машины.
!/.claude/ralph/ralph.project.md

# Локальное состояние сессий: handoff и заметки оператора. Пишутся с путями машины и
# именами потребителей, поэтому публичному репозиторию не принадлежат.
.claude/local/
