    "eventCoverage": {
        "PreToolUse": {
            "mode": "intercepted",
            "evidence": "[[hooks]] PreToolUse в config.toml дома CLI, который собирает раннер (core/session-settings.ts, prepareKimiNativeHome): хук зовётся до эффекта на Write, Edit, Read, Bash (в том числе с cwd вне дерева), Grep, Glob, FetchURL, Agent и MCP, код 2 останавливает вызов — стенд 2.3.2 (adapters/harnesses/__fixtures__/kimi-code-2.3.2-stand.json). Регистрацию судит событие нормализатора пакета (#191), проба на тексте config.toml — перед каждой сессией"
        }
    },
    "configSurfaces": [],
    "forbiddenEnv": [],
