{
    "schemaVersion": 1,
    "harness": "sample",
    "cliVersion": "0.0.0-sample",
    "normalizer": "normalize.ts",
    "toolMap": { "Bash": "exec", "Read": "read", "TodoWrite": "inert" },
    "argMap": {
        "Bash": { "command": "command" },
        "Read": { "path": "file_path" }
    },
    "allowedFields": {
        "envelope": ["session_id", "cwd", "hook_event_name", "tool_name", "tool_input"],
        "tools": {
            "Bash": ["command", "description", "timeout"],
            "Read": ["file_path", "offset", "limit"],
            "TodoWrite": ["todos"]
        }
    },
    "eventCoverage": {
        "shell": { "mode": "intercepted", "evidence": "образец: фикстура, а не снятое с CLI" }
    },
    "configSurfaces": [".sample/config.json"],
    "forbiddenEnv": ["SAMPLE_DISABLE_HOOKS"],
    "mcpNames": { "mcp__fs__read": { "server": "fs", "tool": "read" } },
    "skillEvidence": { "source": "none" },
    "rules": ["AGENTS.md"],
    "inventorySource": "образец: инвентаря нет"
}
